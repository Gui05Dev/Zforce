{
  "name": "zforce-site",
  "private": true,
  "version": "2.0.0",
  "description": "Site institucional da Z-Force Mobilidade Elétrica (HTML, CSS e JS puros, empacotado com Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test --project=chrome",
    "model:build": "node --no-deprecation scripts/optimize-scooter.mjs && node --no-deprecation scripts/optimize-diagnostic-model.mjs",
    "test:gpu": "playwright test --project=gpu",
    "diagnostic:poster": "node scripts/diagnostic-poster.mjs",
    "og:image": "node scripts/og-image.mjs"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "gsap": "3.15.0",
    "motion": "13.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "globals": "^17.0.0",
    "meshoptimizer": "1.2.0",
    "vite": "8.3.0"
  }
}
